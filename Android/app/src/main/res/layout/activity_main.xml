<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- Top App Bar with Title, Status & Mode Actions -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="#1E1E1E"
        android:elevation="4dp"
        app:title="Haven AI"
        app:titleTextColor="#2196F3"
        app:subtitleTextColor="#888888"
        app:subtitle="Online • Tap for status">

        <!-- Action buttons container inside toolbar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp">

            <!-- Voice mode toggle (Speaker icon) -->
            <ImageButton
                android:id="@+id/btnVoiceToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:contentDescription="Toggle voice readout"
                app:tint="#64B5F6" />

            <!-- Detailed Status collapse/expand button -->
            <ImageButton
                android:id="@+id/btnToggleStatus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_info_details"
                android:contentDescription="Toggle server stats"
                app:tint="#888888" />

            <!-- Modes and Tools menu button -->
            <ImageButton
                android:id="@+id/btnModes"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_manage"
                android:contentDescription="Modes and tools"
                app:tint="#888888" />

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Collapsible Detailed Status Bar (Hidden until requested to keep UI clean) -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center"
        android:weightSum="4"
        android:visibility="gone">

        <TextView
            android:id="@+id/statusModel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Model: ---"
            android:textColor="#888888"
            android:textSize="11sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/statusMemory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Memory: ---"
            android:textColor="#888888"
            android:textSize="11sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/statusTTS"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TTS: ---"
            android:textColor="#888888"
            android:textSize="11sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/statusConnection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Net: ---"
            android:textColor="#888888"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Chat Messages RecyclerView (Takes full screen when status bar is collapsed) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- Input Area (Raised automatically above navigation bar and keyboard) -->
    <LinearLayout
        android:id="@+id/inputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical">

        <!-- Voice / Microphone button for Speech-to-Text -->
        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="Voice Input (STT)"
            app:tint="#64B5F6" />

        <!-- Clear, high-visibility text input box -->
        <EditText
            android:id="@+id/editText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:minHeight="44dp"
            android:maxLines="4"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:hint="@string/type_message"
            android:textColor="#FFFFFF"
            android:textColorHint="#757575"
            android:textSize="15sp"
            android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="actionSend" />

        <!-- Send message button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_send"
            android:contentDescription="@string/send_message"
            app:fabCustomSize="44dp"
            app:maxImageSize="22dp"
            app:backgroundTint="#2196F3"
            app:tint="#FFFFFF"
            app:elevation="2dp" />

    </LinearLayout>

</LinearLayout>
